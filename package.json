{
  "name": "tinitus",
  "version": "1.0.0",
  "description": "Tinitus: terapia sonora, relajación y seguimiento para el acúfeno (tinnitus).",
  "author": {
    "name": "Ariel Couso",
    "email": "25914566+arcsurf@users.noreply.github.com"
  },
  "homepage": "https://github.com/arcsurf/tinitus",
  "main": "electron/main.js",
  "license": "MIT",
  "scripts": {
    "web": "npx serve www",
    "desktop": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "cap:ios": "cap open ios"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.tinitus.mobile",
    "productName": "Tinitus",
    "files": [
      "electron/**",
      "www/**",
      "package.json",
      "!electron/linux/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "www/icons/icon-512.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.healthcare-fitness",
      "icon": "www/icons/icon-512.png"
    },
    "linux": {
      "target": [
        "deb",
        "rpm"
      ],
      "icon": "www/icons/icon-512.png",
      "category": "AudioVideo",
      "synopsis": "Sound therapy, relaxation and tracking for tinnitus",
      "executableName": "tinitus"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "libasound2t64 | libasound2"
      ],
      "artifactName": "Tinitus-${arch}.deb",
      "afterInstall": "electron/linux/deb-after-install.sh",
      "afterRemove": "electron/linux/deb-after-remove.sh"
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "(libXtst or libXtst6)",
        "xdg-utils",
        "at-spi2-core",
        "(libuuid or libuuid1)",
        "alsa-lib"
      ],
      "artifactName": "Tinitus-${arch}.rpm",
      "afterRemove": "electron/linux/rpm-after-remove.sh"
    }
  }
}
